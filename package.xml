<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_force_sensor_bota</name>
  <version>0.0.0</version>
  <description>Bota Systems force torque sensor package compliant with the SmartArmStack sas framework</description>
  <maintainer email="murilo.marinho@manchester.ac.uk">Murilo Marinho</maintainer>
  <license>LGPL-2.1-only</license>

  <!-- No buildtool_depend on ament_python: it is not a rosdep key, and the
       SmartArmStack deb builder (SmartArmStack/smart_arm_stack_ROS2,
       build_ros2.sh -> bloom-generate rosdebian) aborts on unresolvable
       keys. colcon takes the build type from <export> below. -->

  <depend>geometry_msgs</depend>
  <depend>sas_core</depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pyqt6</exec_depend>
  <exec_depend>python3-pyqtgraph</exec_depend>

  <!-- bota_driver (TheRoboticsStudio/bota_driver) is not released and has no
       rosdep key; clone it into the workspace or `pip install bota-driver`
       (see requirements.txt).
       qdarktheme has no rosdep key; install from PyPI:
       pip install pyqtdarktheme. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
